<?xml version="1.0" encoding="UTF-8"?>
<!--
  app 模块 —— 唯一启动模块（模块化单体的组装层）

  职责：
    1. 聚合全部业务模块（access/auth/billing/router/admin）为一个 JVM；
    2. 提供唯一入口 AiGatewayApplication（root 包扫描 com.ai.gateway.*）；
    3. application.yml —— 全部外部依赖（MySQL/Redis/上游模型服务）占位符化，
       本地默认值开箱即用，生产用环境变量覆盖（修 P7）；
    4. 打包：spring-boot-maven-plugin repackage 出可执行 fat jar
       （java -jar ai-gateway-app.jar 一键启动）。

  依赖方向铁律：本模块只做组装，不写业务代码。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ai.gateway</groupId>
        <artifactId>ai-gateway-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ai-gateway-app</artifactId>
    <name>ai-gateway-app</name>
    <description>启动模块：模块化单体组装与一键启动</description>

    <dependencies>
        <!-- ========== 业务模块（组装） ========== -->
        <dependency>
            <groupId>com.ai.gateway</groupId>
            <artifactId>ai-gateway-access</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ai.gateway</groupId>
            <artifactId>ai-gateway-admin</artifactId>
        </dependency>
        <!-- router/billing/auth/common 由上面两个模块传递引入，显式声明以表达"全量组装"意图 -->
        <dependency>
            <groupId>com.ai.gateway</groupId>
            <artifactId>ai-gateway-router</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ai.gateway</groupId>
            <artifactId>ai-gateway-billing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ai.gateway</groupId>
            <artifactId>ai-gateway-auth</artifactId>
        </dependency>

        <!-- ========== 运行时依赖 ========== -->
        <!-- MySQL 驱动（版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- OpenAPI3 文档（swagger-ui） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- 健康检查（白名单放行 /actuator/health，运维观测） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标暴露：/actuator/prometheus（Micrometer 注册表，版本随 Boot BOM） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- repackage：产出可执行 fat jar（唯一含该插件的模块） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.ai.gateway.AiGatewayApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
